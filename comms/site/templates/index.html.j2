{% extends "base.html.j2" %}
{% block title %}Parser Security Eval — Results{% endblock %}

{% block content %}

{# ── Hero ──────────────────────────────────────────────────────────────── #}
<div class="hero" id="top">
  <div class="hero-label">Experiment Results · {{ build_date }}</div>
  <h1>Toward an RL environment<br>for parser security</h1>
  <p>Early-stage eval measuring whether AI agents can find and fix
     vulnerabilities in production C parsers — building toward a
     red-blue training loop for
     <a href="https://www.lesswrong.com/posts/8wtrLoDPyCfMLuHkt/how-to-solve-secure-program-synthesis"
        target="_blank" style="color:var(--accent)">secure program synthesis</a>.</p>
  <div class="hero-meta">
    <span class="badge">Inspect-AI</span>
    <span class="badge">OSS-Fuzz targets</span>
    <span class="badge">ARVO benchmark</span>
    <a class="badge issue"
       href="https://github.com/for-all-dev/parser-security-eval"
       target="_blank">GitHub ↗</a>
  </div>
</div>

{% if is_example %}
<div class="example-banner">
  ⚠ Showing <strong>example data</strong>. Run
  <code>uv run python build.py</code> from <code>comms/site/</code> to load real results.
</div>
{% endif %}

{# ── Headline stat cards ──────────────────────────────────────────────── #}
<div class="stats-grid">
  <div class="stat-card">
    <div class="label">Parser targets</div>
    <div class="value">4</div>
    <div class="sub">libpng · libjpeg-turbo · libxml2 · zlib</div>
  </div>
  <div class="stat-card">
    <div class="label">Ground-truth CVEs</div>
    <div class="value">209 <span style="font-size:.6em;color:var(--text-muted)">/ 5,001</span></div>
    <div class="sub">subset of ARVO (4 targets of ~150 parser projects)</div>
  </div>
  <div class="stat-card accent-amber">
    <div class="label">Crashes found by agents</div>
    <div class="value">0</div>
    <div class="sub">the open problem we're working on</div>
  </div>
  <div class="stat-card">
    <div class="label">Status</div>
    <div class="value" style="font-size:1.4rem">Early</div>
    <div class="sub">preliminary results, active development</div>
  </div>
</div>

{# ── Experiments ───────────────────────────────────────────────────────── #}
{% for exp in experiments %}

{# ── Patching ── #}
{% if exp.task == 'patching' %}
<div id="patching" style="scroll-margin-top:70px">
  <div class="section-title">🔧 Patching (Baseline Task)</div>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;font-size:.95rem;max-width:680px">
    Given a known crash and the source, can the model produce a working patch?
    This validates our scoring pipeline — the harder task is autonomous crash discovery below.
  </p>

  <div class="chart-grid-2">
    {# Model comparison (horizontal bar) #}
    {% if exp.stats.model_avg_chart %}
    <div class="card">
      <div class="card-title">Model Comparison</div>
      <p style="color:var(--text-muted);font-size:.82rem;margin-bottom:1rem">
        Mean patch success rate per model across all {{ exp.stats.target_count }} targets
        (patch applies → compiles → crash eliminated).
      </p>
      <div class="chart-wrap" style="min-height:160px">
        <canvas id="{{ exp.name }}-modelAvg"></canvas>
      </div>
    </div>
    {% endif %}

    {# Score grid #}
    {% if exp.stats.status_matrix %}
    <div class="card">
      <div class="card-title">Score by Target</div>
      <p style="color:var(--text-muted);font-size:.82rem;margin-bottom:.75rem">
        Per-model, per-target patch success rate (0–1).
      </p>
      {% set matrix = exp.stats.status_matrix %}
      {% set n_t = matrix.targets | length %}
      <div class="score-grid"
           style="grid-template-columns: max-content {% for _ in matrix.targets %}1fr {% endfor %}">
        <div></div>
        {% for t in matrix.targets %}
        <div class="grid-header">{{ t }}</div>
        {% endfor %}
        {% for mi in range(matrix.models | length) %}
        <div class="grid-label">{{ matrix.models[mi] }}</div>
        {% for ti in range(n_t) %}
        {% set cell = matrix.cells[mi * n_t + ti] %}
        <div class="grid-cell"
             {% if cell.score is not none %}
             style="background:hsl({{ cell.score_hue }},58%,16%);border-color:hsl({{ cell.score_hue }},58%,28%)"
             {% endif %}
             title="{{ matrix.models[mi] }} × {{ matrix.targets[ti] }}{% if cell.score is not none %}: {{ '%.3f'|format(cell.score) }}{% endif %}">
          {% if cell.score is not none %}
          <span style="color:hsl({{ cell.score_hue }},80%,68%);font-weight:700;font-size:.95rem">
            {{ '%.2f'|format(cell.score) }}
          </span>
          {% else %}
          <span style="color:var(--text-dim)">—</span>
          {% endif %}
        </div>
        {% endfor %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  {# ── Score by Target (per-model bar chart) ── #}
  {% if exp.stats.config_charts %}
  <div class="card" style="margin-top:1rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
      <div class="card-title" style="margin:0">Score by Target</div>
      <select id="{{ exp.name }}-configModelSel"
              onchange="switchConfigChart('{{ exp.name }}', this.value)"
              style="background:var(--bg-card-2);border:1px solid var(--border);
                     color:var(--text);border-radius:6px;padding:.3rem .7rem;
                     font-size:.83rem;cursor:pointer">
        {% for model in exp.stats.config_charts.models %}
        <option value="{{ model }}"
                {% if model == exp.stats.config_charts.default_model %}selected{% endif %}>
          {{ model }}
        </option>
        {% endfor %}
      </select>
    </div>
    <p style="color:var(--text-muted);font-size:.82rem;margin-bottom:1rem">
      Patch success rate per target for the selected model.
    </p>
    {% for model in exp.stats.config_charts.models %}
    <div id="{{ exp.name }}-configChartWrap-{{ model }}"
         {% if model != exp.stats.config_charts.default_model %}style="display:none"{% endif %}>
      <div class="chart-wrap" style="min-height:200px">
        <canvas id="{{ exp.name }}-configCanvas-{{ model }}"></canvas>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
{% endif %}

{# ── Fuzzing ── #}
{% if exp.task == 'fuzzing' %}
<div id="fuzzing" style="scroll-margin-top:70px;margin-top:1rem">
  <div class="section-title">🔍 Autonomous Crash Discovery (The Hard Part)</div>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;font-size:.95rem;max-width:680px">
    Can an agent autonomously find crashes? This is the core research question
    and the bottleneck to building an RL-ready red-blue loop.
  </p>

  <div class="card" style="border-color:rgba(251,191,36,.2)">
    <div style="display:flex;align-items:flex-start;gap:1rem;
                padding:.85rem 1rem;margin-bottom:1.25rem;
                background:rgba(251,191,36,.06);border-radius:var(--radius);
                border:1px solid rgba(251,191,36,.18)">
      <span style="font-size:1.3rem;line-height:1.2;flex-shrink:0">⚠</span>
      <div>
        <div style="font-weight:600;color:var(--accent-amber);margin-bottom:.3rem">
          Crash-discovery scores are near zero — this is the open challenge
        </div>
        <div style="color:var(--text-muted);font-size:.88rem;line-height:1.6">
          Models successfully generate and compile LibFuzzer harnesses but do not yet
          find crashes within the allotted time budget.
          This is precisely the gap the next phase of the eval is designed to close.
          All {{ exp.stats.completed }} runs completed; near-zero scores are a
          genuine signal, not a pipeline failure.
        </div>
      </div>
    </div>

    {% if exp.stats.status_matrix %}
    <div class="card-title" style="margin-bottom:.75rem">Run Matrix</div>
    <p style="color:var(--text-muted);font-size:.82rem;margin-bottom:.75rem">
      {{ exp.stats.model_count }} models × {{ exp.stats.target_count }} targets.
    </p>
    {% set matrix = exp.stats.status_matrix %}
    {% set n_t = matrix.targets | length %}
    <div class="score-grid"
         style="grid-template-columns: max-content {% for _ in matrix.targets %}1fr {% endfor %}">
      <div></div>
      {% for t in matrix.targets %}
      <div class="grid-header">{{ t }}</div>
      {% endfor %}
      {% for mi in range(matrix.models | length) %}
      <div class="grid-label">{{ matrix.models[mi] }}</div>
      {% for ti in range(n_t) %}
      {% set cell = matrix.cells[mi * n_t + ti] %}
      <div class="grid-cell"
           {% if cell.score is not none %}
           style="background:hsl({{ cell.score_hue }},58%,16%);border-color:hsl({{ cell.score_hue }},58%,28%)"
           {% endif %}
           title="{{ matrix.models[mi] }} × {{ matrix.targets[ti] }}{% if cell.score is not none %}: {{ '%.4f'|format(cell.score) }}{% endif %}">
        {% if cell.score is not none %}
        <span style="color:hsl({{ cell.score_hue }},80%,68%);font-weight:600;font-size:.8rem">
          {{ '%.3f'|format(cell.score) }}
        </span>
        {% else %}
        <span style="color:var(--text-dim)">—</span>
        {% endif %}
      </div>
      {% endfor %}
      {% endfor %}
    </div>
    {% endif %}
  </div>

</div>
{% endif %}

{% endfor %}

{# ── Prose content ─────────────────────────────────────────────────────── #}
{% if content %}
<div style="margin-top:.5rem">
  {% for key, page in content.items() %}
  <div class="card" id="{{ key }}" style="scroll-margin-top:70px">
    <div class="prose">{{ page.html | safe }}</div>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ── Roadmap ───────────────────────────────────────────────────────────── #}
<section id="roadmap" style="scroll-margin-top:70px">
  <div class="card">
    <div class="card-title"><span class="icon">🗺</span> Roadmap</div>
    <p style="color:var(--text-muted);font-size:.88rem;margin-bottom:1.5rem">
      Scoring pipeline is validated. Next: make the red-team agent actually find crashes,
      then close the loop into an RL-ready environment.
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem">
      {% set items = [
        {"issue": 54,  "icon": "🐝", "title": "Better Fuzz Agents",
         "desc": "The core bottleneck: get agents to reliably discover crashes. Swarm scaling, better harness strategies, longer time budgets."},
        {"issue": 76,  "icon": "🔄", "title": "Red-Blue Loop",
         "desc": "Red-team finds a crash, blue-team patches it, red-team retries. This adversarial cycle is the natural RL training signal."},
        {"issue": 77,  "icon": "🧬", "title": "RL Environment",
         "desc": "Package the red-blue loop as a post-training environment. The long-term goal: models that get better at writing secure code through self-play."},
      ] %}
      {% for item in items %}
      <a href="https://github.com/for-all-dev/parser-security-eval/issues/{{ item.issue }}"
         target="_blank"
         style="text-decoration:none;display:block;
                background:var(--bg-card-2);border:1px solid var(--border);
                border-radius:var(--radius-lg);padding:1.25rem;
                transition:border-color .15s,background .15s"
         onmouseover="this.style.borderColor='var(--accent)';this.style.background='#1e2640'"
         onmouseout="this.style.borderColor='var(--border)';this.style.background='var(--bg-card-2)'">
        <div style="font-size:1.4rem;margin-bottom:.5rem">{{ item.icon }}</div>
        <div style="font-weight:600;color:var(--text);margin-bottom:.4rem">{{ item.title }}</div>
        <div style="font-size:.83rem;color:var(--text-muted);line-height:1.55">{{ item.desc }}</div>
        <div style="margin-top:.8rem;font-size:.75rem;color:var(--text-dim)">Issue #{{ item.issue }} ↗</div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
const _configCharts = {};

{% for exp in experiments %}
{% if exp.stats.model_avg_chart %}
(function() {
  const data = {{ exp.stats.model_avg_chart | tojson }};
  new Chart(document.getElementById('{{ exp.name }}-modelAvg'), {
    type: 'bar',
    data: data,
    options: {
      indexAxis: 'y',
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: {
          beginAtZero: true,
          max: 1.0,
          title: { display: true, text: 'Mean success rate', color: '#8a9bb8' },
          grid: { color: 'rgba(37,46,69,.6)' },
          ticks: { callback: function(v) { return (v * 100).toFixed(0) + '%'; } }
        },
        y: { grid: { color: 'rgba(37,46,69,.4)' } }
      }
    }
  });
})();
{% endif %}
{% if exp.stats.config_charts %}
(function() {
  const charts = {{ exp.stats.config_charts.charts | tojson }};
  const models = {{ exp.stats.config_charts.models | tojson }};
  models.forEach(function(model) {
    const key = '{{ exp.name }}-configCanvas-' + model;
    _configCharts[key] = new Chart(document.getElementById(key), {
      type: 'bar',
      data: charts[model],
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: 'rgba(37,46,69,.6)' }, ticks: { color: '#8a9bb8' } },
          y: {
            beginAtZero: true, max: 1.0,
            title: { display: true, text: 'Score', color: '#8a9bb8' },
            grid: { color: 'rgba(37,46,69,.6)' },
            ticks: { color: '#8a9bb8', callback: function(v) { return (v*100).toFixed(0)+'%'; } }
          }
        }
      }
    });
  });
})();
{% endif %}
{% endfor %}
function switchConfigChart(expName, model) {
  document.querySelectorAll('[id^="' + expName + '-configChartWrap-"]').forEach(function(el) {
    el.style.display = 'none';
  });
  document.getElementById(expName + '-configChartWrap-' + model).style.display = '';
  const key = expName + '-configCanvas-' + model;
  if (_configCharts[key]) { _configCharts[key].resize(); }
}
</script>
{% endblock %}
