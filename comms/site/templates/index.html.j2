{% extends "base.html.j2" %}
{% block title %}Overview{% endblock %}

{% block content %}
<!-- Hero -->
<div class="hero">
  {% if experiment.task %}
  <div class="hero-label">{{ experiment.task | upper }} EXPERIMENT</div>
  {% endif %}
  <h1>{{ experiment.name or experiment.id or 'Experiment Results' }}</h1>
  {% if experiment.description and experiment.description != experiment.name %}
  <p>{{ experiment.description }}</p>
  {% endif %}
  <div class="hero-meta">
    {% if experiment.id %}<span class="badge">{{ experiment.id }}</span>{% endif %}
    {% if experiment.task %}<span class="badge">{{ experiment.task }}</span>{% endif %}
    {% if stats.engine %}<span class="badge">{{ stats.engine }}</span>{% endif %}
    {% if experiment.created_at %}<span class="badge">started {{ experiment.created_at[:10] }}</span>{% endif %}
    {% if is_example %}<span class="badge example">example data</span>{% endif %}
  </div>
</div>

<!-- Stat cards -->
{% if stats %}
<div class="stats-grid">
  <div class="stat-card accent-blue">
    <div class="label">Total Runs</div>
    <div class="value">{{ stats.total_runs }}</div>
    <div class="sub">
      {{ (stats.grid_models or []) | length }} model(s) ×
      {{ (stats.grid_targets or []) | length }} target(s)
    </div>
  </div>

  <div class="stat-card accent-green">
    <div class="label">Completed</div>
    <div class="value">{{ stats.completed }}</div>
    <div class="sub">
      {% if stats.total_runs > 0 %}
        {{ (stats.completed / stats.total_runs * 100) | round(0) | int }}% of runs
      {% endif %}
    </div>
  </div>

  <div class="stat-card accent-red">
    <div class="label">Failed</div>
    <div class="value">{{ stats.failed }}</div>
    <div class="sub">{{ stats.running }} running · {{ stats.pending }} pending</div>
  </div>

  {% if stats.mean_duration_min is defined %}
  <div class="stat-card accent-teal">
    <div class="label">Mean Run Time</div>
    <div class="value">{{ stats.mean_duration_min }}<span style="font-size:1rem;color:var(--text-muted)"> min</span></div>
    <div class="sub">range {{ stats.min_duration_min }}–{{ stats.max_duration_min }} min</div>
  </div>
  {% endif %}

  {% if stats.max_rounds %}
  <div class="stat-card">
    <div class="label">Rounds / Run</div>
    <div class="value">{{ stats.max_rounds }}</div>
    <div class="sub">{{ stats.round_duration }}s per round</div>
  </div>
  {% endif %}

  {% if stats.best_model %}
  <div class="stat-card accent-amber">
    <div class="label">Best Model</div>
    <div class="value" style="font-size:1.4rem">{{ stats.best_model }}</div>
    <div class="sub">score {{ stats.best_score }}</div>
  </div>
  {% endif %}
</div>

<!-- Status donut + matrix -->
{% if stats.status_donut or stats.status_matrix %}
<div class="chart-grid-2" style="margin-bottom:1.5rem">

  {% if stats.status_donut %}
  <div class="card" style="margin-bottom:0">
    <div class="card-title"><span class="icon">🔵</span> Run Status</div>
    <div class="chart-wrap" style="max-height:280px">
      <canvas id="statusDonut"></canvas>
    </div>
  </div>
  {% endif %}

  {% if stats.status_matrix %}
  {% set mx = stats.status_matrix %}
  <div class="card" style="margin-bottom:0">
    <div class="card-title"><span class="icon">⊞</span> Model × Target Grid</div>
    <div style="overflow-x:auto">
      <table style="min-width:0;font-size:.82rem">
        <thead>
          <tr>
            <th style="text-align:left;padding:.4rem .75rem;background:var(--bg-card-2);color:var(--text-dim);font-size:.72rem;text-transform:uppercase;letter-spacing:.07em">Model</th>
            {% for t in mx.targets %}
            <th style="text-align:center;padding:.4rem .75rem;background:var(--bg-card-2);color:var(--text-dim);font-size:.72rem;text-transform:uppercase;letter-spacing:.07em">{{ t }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for model_short in mx.models %}
          <tr>
            <td style="padding:.5rem .75rem;font-size:.82rem;white-space:nowrap;color:var(--text-muted)">{{ model_short }}</td>
            {% for target in mx.targets %}
            {% set cell = mx.cells | selectattr("model_short","equalto",model_short) | selectattr("target","equalto",target) | first | default(none) %}
            {% if cell %}
              {% set status = cell.status %}
              {% if status == 'completed' %}{% set bg = 'rgba(52,211,153,0.15)' %}{% set color = '#34d399' %}{% set icon = '✓' %}
              {% elif status == 'failed' %}{% set bg = 'rgba(248,113,113,0.15)' %}{% set color = '#f87171' %}{% set icon = '✗' %}
              {% elif status == 'running' %}{% set bg = 'rgba(251,191,36,0.12)' %}{% set color = '#fbbf24' %}{% set icon = '⟳' %}
              {% else %}{% set bg = 'rgba(148,163,184,0.06)' %}{% set color = '#4e617a' %}{% set icon = '·' %}{% endif %}
              <td title="{{ cell.error or status }}{% if cell.duration_min %} ({{ cell.duration_min }} min){% endif %}"
                  style="text-align:center;padding:.5rem .75rem;background:{{ bg }};color:{{ color }};font-weight:600;cursor:default">
                {{ icon }}{% if cell.duration_min and status == 'completed' %}<br><span style="font-size:.68rem;font-weight:400;color:var(--text-dim)">{{ cell.duration_min }}m</span>{% endif %}
              </td>
            {% else %}
              <td style="text-align:center;padding:.5rem .75rem;color:var(--text-dim)">—</td>
            {% endif %}
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p style="font-size:.75rem;color:var(--text-dim);margin-top:.75rem">
      ✓ completed &nbsp;✗ failed &nbsp;⟳ running &nbsp;· pending
      &nbsp;—&nbsp;Hover for error details.
    </p>
  </div>
  {% endif %}

</div>
{% endif %}

<!-- Duration chart (completed runs) -->
{% if stats.duration_chart %}
<div class="card">
  <div class="card-title"><span class="icon">⏱</span> Run Durations (completed)</div>
  <div class="chart-wrap">
    <canvas id="durationChart"></canvas>
  </div>
</div>
{% endif %}

{% endif %}{# end if stats #}

<!-- Content prose -->
{% for key, page in content.items() %}
<div class="card">
  <div class="card-title"><span class="icon">📄</span> {{ page.title }}</div>
  <div class="prose">{{ page.html | safe }}</div>
</div>
{% endfor %}
{% endblock %}

{% block scripts %}
<script>
{% if stats.status_donut %}
(function() {
  const data = {{ stats.status_donut | tojson }};
  new Chart(document.getElementById('statusDonut'), {
    type: 'doughnut',
    data: data,
    options: {
      responsive: true,
      cutout: '65%',
      plugins: {
        legend: { position: 'bottom' },
        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed}` } }
      }
    }
  });
})();
{% endif %}

{% if stats.duration_chart %}
(function() {
  const data = {{ stats.duration_chart | tojson }};
  new Chart(document.getElementById('durationChart'), {
    type: 'bar',
    data: data,
    options: {
      indexAxis: 'y',
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: {
          title: { display: true, text: 'Minutes', color: '#8a9bb8' },
          grid: { color: 'rgba(37,46,69,.6)' },
          beginAtZero: true
        },
        y: { grid: { display: false }, ticks: { font: { size: 11 } } }
      }
    }
  });
})();
{% endif %}
</script>
{% endblock %}
